# Copy to service/.env and fill in. service/.env is gitignored - never commit it.
# Card acceptance: "Secrets load from local configuration and are excluded from source."

# --- Network -----------------------------------------------------------------
# Localhost by default. Do not bind 0.0.0.0 on the VX PC.
AIHOLO_HOST=127.0.0.1
AIHOLO_PORT=8765

# --- Ollama ------------------------------------------------------------------
AIHOLO_OLLAMA_URL=http://127.0.0.1:11434
# Set from the winner of `python -m bench.bench_ollama`
AIHOLO_OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
AIHOLO_OLLAMA_TIMEOUT_S=25

# --- Speech to text ----------------------------------------------------------
# Set from the winner of `python -m bench.bench_stt`
AIHOLO_STT_MODEL=small.en
AIHOLO_STT_DEVICE=auto
AIHOLO_STT_COMPUTE=int8

# --- Retrieval ---------------------------------------------------------------
# An Ollama model - embeddings go through Ollama, so torch is not installed at all.
#   ollama pull nomic-embed-text
AIHOLO_EMBED_MODEL=nomic-embed-text
AIHOLO_RETRIEVE_TOP_K=4
# Below this cosine score nothing is considered grounded and the service says so.
# Set this from scripts/calibrate_floor.py, not by guessing.
AIHOLO_GROUNDING_FLOOR=0.54

# --- Azure Speech ------------------------------------------------------------
AIHOLO_AZURE_KEY=
AIHOLO_AZURE_REGION=australiaeast
AIHOLO_AZURE_VOICE=en-AU-NatashaNeural

# --- Modes -------------------------------------------------------------------
# true = answer and speak without Ollama or Azure, so Unity can be developed
# against the real contract before the VX PC is available. Never demo in mock.
AIHOLO_MOCK=false

# --- Generated state ---------------------------------------------------------
# Where the index, reply audio and viseme tracks are written. Defaults to
# service/var. Point it elsewhere for experiments so a mock-mode reindex cannot
# overwrite the index the running service is serving.
# AIHOLO_VAR_DIR=/tmp/aiholo-experiment
